@@ -98,6 +98,64 @@ def iou_distance(atracks: list, btracks: list) -> np.ndarray:
     return 1 - ious  # cost matrix
 
 
+def diou_distance(atracks, btracks):
+    """
+    Compute cost based on Distance-IoU (DIoU).
+    DIoU = IoU - (rho^2 / c^2)
+    """
+    # 1. Extracción robusta de las coordenadas usando la misma lógica de iou_distance
+    if (atracks and isinstance(atracks[0], np.ndarray)) or (btracks and isinstance(btracks[0], np.ndarray)):
+        atlbrs = atracks
+        btlbrs = btracks
+    else:
+        # Extraemos en formato xyxy (top-left x, top-left y, bottom-right x, bottom-right y)
+        atlbrs = [track.xyxy for track in atracks]
+        btlbrs = [track.xyxy for track in btracks]
+
+    if len(atlbrs) == 0 or len(btlbrs) == 0:
+        return np.zeros((len(atlbrs), len(btlbrs)), dtype=np.float32)
+
+    # Asegurar tipos correctos y contiguos para operaciones NumPy y PyTorch subyacentes
+    atlbrs = np.ascontiguousarray(atlbrs, dtype=np.float32)
+    btlbrs = np.ascontiguousarray(btlbrs, dtype=np.float32)
+
+    # 2. Reutilizamos la función bbox_ioa de Ultralytics para obtener el IoU estándar
+    # bbox_ioa espera cajas en formato [N, 4] o [N, 5]
+    from ultralytics.utils.metrics import bbox_ioa
+    _ious = bbox_ioa(atlbrs, btlbrs, iou=True)
+
+    # Manejar el caso donde bbox_ioa devuelve un tensor de PyTorch (si se corrió en GPU)
+    if hasattr(_ious, 'cpu'):
+        _ious = _ious.cpu().numpy()
+
+    # 3. Calculamos los centros (cx, cy) de ambos grupos de cajas
+    # atlbrs y btlbrs están en formato [x1, y1, x2, y2]
+    cx_a = (atlbrs[:, 0] + atlbrs[:, 2]) / 2.0
+    cy_a = (atlbrs[:, 1] + atlbrs[:, 3]) / 2.0
+    cx_b = (btlbrs[:, 0] + btlbrs[:, 2]) / 2.0
+    cy_b = (btlbrs[:, 1] + btlbrs[:, 3]) / 2.0
+
+    # 4. Distancia euclidiana al cuadrado entre centros (rho^2) - Matriz [N, M]
+    rho2 = (cx_a[:, None] - cx_b[None, :])**2 + (cy_a[:, None] - cy_b[None, :])**2
+
+    # 5. Encontrar la caja envolvente más pequeña que cubre ambas cajas
+    tl_x = np.minimum(atlbrs[:, 0][:, None], btlbrs[:, 0][None, :])
+    tl_y = np.minimum(atlbrs[:, 1][:, None], btlbrs[:, 1][None, :])
+    br_x = np.maximum(atlbrs[:, 2][:, None], btlbrs[:, 2][None, :])
+    br_y = np.maximum(atlbrs[:, 3][:, None], btlbrs[:, 3][None, :])
+
+    # 6. Longitud de la diagonal al cuadrado de la caja envolvente (c^2)
+    c2 = (br_x - tl_x)**2 + (br_y - tl_y)**2
+    c2 = np.maximum(c2, 1e-7)  # Evitar división por cero
+
+    # 7. Cálculo final del DIoU
+    dious = _ious - (rho2 / c2)
+
+    # La matriz de costo es 1 - DIoU
+    cost_matrix = 1.0 - dious
+    return cost_matrix
+
